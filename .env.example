# Offline simulation is the safe default.
FOREX_PROVIDER=simulation
FOREX_MODE=shadow
FOREX_DATABASE_PATH=./forex_trader.db
FOREX_INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY
FOREX_AUTO_DISCOVER_CURRENCY_INSTRUMENTS=false
FOREX_REQUIRE_FUNDAMENTALS=true
FOREX_ENABLE_PAPER_ORDERS=false

# Optional immutable source revision for reproducible campaign evidence.
# Recommended for deployed/local Git runs: git rev-parse HEAD
# GitHub Actions automatically exposes GITHUB_SHA when this is left blank.
FOREX_BUILD_REVISION=

# Strategy timeframe policy. These map directly to the researched grid.
# Lower: M5, M10, M15, M30. Higher: H1, H4.
FOREX_LOWER_TIMEFRAME=M5
FOREX_HIGHER_TIMEFRAME=H1

# Strategy, execution and risk controls.
FOREX_MINIMUM_SCORE=0.66
FOREX_MAXIMUM_SPREAD_PIPS=2.0
FOREX_MAXIMUM_SLIPPAGE_PIPS=0.5
FOREX_RISK_FRACTION=0.0015
FOREX_MAX_DAILY_LOSS_FRACTION=0.01
FOREX_MAX_OPEN_POSITIONS=3
FOREX_MAX_UNITS=100000
FOREX_MAX_GROSS_EXPOSURE_FRACTION=4
FOREX_MAX_CURRENCY_EXPOSURE_FRACTION=2
# Correlation is a veto only; it never increases size. It uses the configured
# higher-timeframe return series and fails closed if an existing position cannot
# be evaluated safely.
FOREX_MAX_SIGNED_CORRELATION=0.85
FOREX_CORRELATION_MINIMUM_OBSERVATIONS=40

# Independent macro/event-factor concentration guard. This is enabled by default
# and is separate from pairwise return correlation and currency-leg exposure.
# With no policy path, the embedded v1 taxonomy matches
# config/macro-factor-clusters-v1.json. A custom policy must classify every traded
# instrument when strict classification is enabled.
FOREX_ENABLE_MACRO_FACTOR_RISK=true
FOREX_MACRO_FACTOR_POLICY_PATH=
FOREX_MAX_MACRO_FACTOR_EXPOSURE_FRACTION=2.5
FOREX_REQUIRE_MACRO_FACTOR_CLASSIFICATION=true

# Optional normalized point-in-time external data exports (JSON or tagged JSONL).
# These paths are runtime inputs only; do not commit licensed/vendor payloads.
# Calendar records preserve available_at and scheduled_at separately. News uses
# received_at as the availability boundary. Cross-asset and flow use observed_at.
FOREX_ECONOMIC_CALENDAR_PATH=
FOREX_NEWS_PATH=
FOREX_CROSS_ASSET_PATH=
FOREX_ORDER_FLOW_PATH=
FOREX_ORDER_FLOW_MAX_AGE_SECONDS=60

# Practice fundamental preflight uses free/no-key first-party official sources by
# default (Fed/BLS, ECB, BoE/ONS, BoJ/Statistics Bureau Japan, SNB, BoC, RBA, RBNZ).
# No additional provider credential is required.

# Legacy/optional Trading Economics integration retained only for explicit research
# or `python scripts/sync_trading_economics.py`. It is NOT used by the Practice
# campaign and is intentionally disabled in the example configuration.
TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_BASE_URL=https://api.tradingeconomics.com
TRADING_ECONOMICS_TIMEOUT_SECONDS=15
TRADING_ECONOMICS_HISTORY_DAYS=30
TRADING_ECONOMICS_WINDOW_DAYS=7
TRADING_ECONOMICS_MIN_IMPORTANCE=2
TRADING_ECONOMICS_AUTO_REFRESH=false
TRADING_ECONOMICS_AUTH_MODE=header
TRADING_ECONOMICS_MAX_PAYLOAD_BYTES=8000000
TRADING_ECONOMICS_COUNTRIES=United States,Euro Area,United Kingdom,Japan,Switzerland,Canada,Australia,New Zealand,China,Czech Republic,Denmark,Hong Kong,Hungary,Mexico,Norway,Poland,Singapore,South Africa,Sweden,Turkey

# Control-plane bearer token. Required for any non-loopback API bind.
# Generate a random local value; never commit the real value.
FOREX_API_TOKEN=

# OANDA fxTrade Practice only. Never commit real values.
OANDA_API_TOKEN=
# Explicit account ID is mandatory whenever broker writes are enabled.
OANDA_ACCOUNT_ID=
OANDA_REST_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_URL=https://stream-fxpractice.oanda.com
OANDA_TIMEOUT_SECONDS=10
