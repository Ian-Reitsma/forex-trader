# Offline simulation is the safe default.
FOREX_PROVIDER=simulation
FOREX_MODE=shadow
FOREX_DATABASE_PATH=./forex_trader.db
FOREX_INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY
FOREX_AUTO_DISCOVER_CURRENCY_INSTRUMENTS=false
FOREX_REQUIRE_FUNDAMENTALS=true
FOREX_ENABLE_PAPER_ORDERS=false

# Strategy timeframe policy. These map directly to the researched grid.
# Lower: M5, M10, M15, M30. Higher: H1, H4.
FOREX_LOWER_TIMEFRAME=M5
FOREX_HIGHER_TIMEFRAME=H1

# Strategy, execution and risk controls.
FOREX_MINIMUM_SCORE=0.66
FOREX_MAXIMUM_SPREAD_PIPS=2.0
FOREX_MAXIMUM_SLIPPAGE_PIPS=0.5
FOREX_RISK_FRACTION=0.0015
FOREX_MAX_DAILY_LOSS_FRACTION=0.01
FOREX_MAX_OPEN_POSITIONS=3
FOREX_MAX_UNITS=100000
FOREX_MAX_GROSS_EXPOSURE_FRACTION=4
FOREX_MAX_CURRENCY_EXPOSURE_FRACTION=2

# Control-plane bearer token. Required for any non-loopback API bind.
# Generate a random local value; never commit the real value.
FOREX_API_TOKEN=

# OANDA fxTrade Practice only. Never commit real values.
OANDA_API_TOKEN=
# Explicit account ID is mandatory whenever broker writes are enabled.
OANDA_ACCOUNT_ID=
OANDA_REST_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_URL=https://stream-fxpractice.oanda.com
OANDA_TIMEOUT_SECONDS=10
